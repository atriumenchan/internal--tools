NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_EMAIL=ryan@admexo.com

# Server-only. Used by the admin Staff page to create logins.
# Supabase → Settings → API → service_role (secret). Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
ADMIN_PASSWORD=choose-a-strong-admin-password

# Cloudflare R2 holds task files. Without these, task files fall back to Supabase Storage.
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret
R2_BUCKET=task-files

# WhatsApp Cloud API. Token stays on Vercel as a secret. Phone number ID is the Registered row.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=1269726706235216
WHATSAPP_WABA_ID=4130948003709192
WHATSAPP_TEMPLATE_NAME=admexo_workspace_alert
WHATSAPP_TEMPLATE_LANG=en_US
WHATSAPP_VERIFY_TOKEN=admexo-whatsapp-verify

