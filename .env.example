NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_EMAIL=ryan@admexo.com

# Server-only. Used by the admin Staff page to create logins.
# Supabase → Settings → API → service_role (secret). Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
ADMIN_PASSWORD=choose-a-strong-admin-password

# WhatsApp Cloud API. Same string you paste as Verify token in Meta Production setup.
WHATSAPP_VERIFY_TOKEN=admexo-whatsapp-verify

# Server-only. Powers /mind (DeepSeek as the data assistant). Never prefix with NEXT_PUBLIC_.
DEEPSEEK_API_KEY=your_deepseek_api_key_here

